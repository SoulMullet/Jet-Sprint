{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet-sprint:player-profile:v1",
  "title": "JET SPRINT local/shared player profile v1",
  "description": "One boat, fictional integer-dollar economy. Browser adapter only; future backend must validate commands and commit revisions atomically. Executable validation also rejects reserved object keys and enforces bounded revisions/attempt relationships. Physics/course/economy definitions export separately.",
  "type": "object",
  "required": [
    "type",
    "schemaVersion",
    "id",
    "revision",
    "economyVersion",
    "cash",
    "lifetimeEarnings",
    "boat",
    "career",
    "results",
    "extensions"
  ],
  "properties": {
    "type": {
      "const": "jet-sprint-player-profile"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "economyVersion": {
      "const": "garage-economy-v1"
    },
    "cash": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "lifetimeEarnings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "boat": {
      "type": "object",
      "required": [
        "id",
        "fuel",
        "condition",
        "installedUpgrades"
      ],
      "properties": {
        "id": {
          "const": "sprint-boat-1987-v1"
        },
        "fuel": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "condition": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "installedUpgrades": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          }
        }
      }
    },
    "career": {
      "type": "object",
      "required": [
        "unlockedCourses",
        "completedCourses",
        "records",
        "sequence",
        "paidSequence",
        "activeAttempt"
      ],
      "properties": {
        "unlockedCourses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          }
        },
        "completedCourses": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          }
        },
        "records": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "object",
            "required": [
              "revision",
              "best",
              "recent",
              "completions",
              "completed"
            ],
            "properties": {
              "revision": {
                "type": "string",
                "maxLength": 100
              },
              "best": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 86400
              },
              "recent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 86400
              },
              "completions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "completed": {
                "const": true
              }
            }
          }
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "paidSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "activeAttempt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "sequence",
                "courseId",
                "revision",
                "gateCount",
                "checkpoints",
                "seconds",
                "lastGateTime",
                "valid",
                "clean",
                "practice"
              ],
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "courseId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "revision": {
                  "type": "string",
                  "maxLength": 100
                },
                "gateCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                },
                "checkpoints": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 500
                },
                "seconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "lastGateTime": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "valid": {
                  "type": "boolean"
                },
                "clean": {
                  "type": "boolean"
                },
                "practice": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "courseId",
          "sequence",
          "total",
          "prize",
          "at"
        ],
        "properties": {
          "courseId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "total": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 86400
          },
          "prize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "at": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Bounded to 64 KB by executable validator. Validated legacy campaign record summaries and future portable fields."
    }
  }
}
